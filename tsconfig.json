{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "src/*": [
        "./src/*"
      ],
      "components/*": [
        "./src/components/*"
      ],
      "hooks/*": [
        "./src/hooks/*"
      ],
      "assets/*": [
        "./public/assets/*"
      ]
    },
    "types": [
      "jest",
      "node"
    ]
  }
}
