{
  "name": "minesofdoom",
  "version": "1.0.0",
  "homepage": "https://minesofdoom.pages.dev",
  "main": "expo-router/entry",
  "scripts": {
    "predeploy": "expo export -p web",
    "deploy": "wrangler pages deploy dist --project-name=minesofdoom",
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest",
    "test:e2e": "maestro test maestro/flows",
    "test:e2e:web": "expo export -p web && playwright test --config playwright.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "play": "node scripts/play/play.mjs",
    "playstoress": "node scripts/playstoress.mjs",
    "postinstall": "node scripts/link-playstoress-bin.mjs"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.15",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-google-signin/google-signin": "^16.1.5",
    "@types/pako": "^3.0.0",
    "expo": "^57.0.19",
    "expo-apple-authentication": "^57.0.1",
    "expo-audio": "^57.0.4",
    "expo-constants": "~57.0.17",
    "expo-file-system": "~57.0.6",
    "expo-iap": "5.5.0",
    "expo-linking": "~57.0.9",
    "expo-localization": "~57.0.1",
    "expo-router": "~57.0.18",
    "expo-sharing": "~57.0.18",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.3",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "pako": "^3.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-google-mobile-ads": "16.0.1",
    "react-native-keychain": "^10.0.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@eslint/js": "^9.0.0",
    "@expo/config-plugins": "57.0.9",
    "@react-native-community/cli": "^20.1.0",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "29.5.14",
    "@types/node": "^22.20.1",
    "@types/react": "~19.2.18",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.34.1",
    "eslint-plugin-react-hooks": "^4.6.0",
    "globals": "^15.0.0",
    "googleapis": "^178.0.0",
    "metro": "^0.84.4",
    "playwright": "1.63.0",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^7.5.0"
  },
  "private": true
}
