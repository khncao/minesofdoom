{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "echo",
            "type": "shell",
            "command": "echo Hello"
        },
        {
            "label": "merge dev into main",
            "type": "shell",
            "command": "git checkout main && git merge dev && git push && git checkout dev"
        },
        {
            "label": "build-release-android",
            "type": "shell",
            "command": "npx react-native build-android --mode=release"
        },
        {
            "label": "start expo",
            "type": "shell",
            "command": "npx expo start --port 8082"
        },
        {
            "label": "start expo android",
            "type": "shell",
            "command": "npx expo run:android -d mines-play-35"
        },
        {
            "label": "build web static",
            "type": "shell",
            "command": "npx expo export -p web"
        },
        {
            // Boots the phone AVD headless (if not already running), waits for
            // boot, then `npm run android -- -d <serial>`.
            "label": "Android: run on phone (mines-play-35)",
            "detail": "scripts/run-android-avd.mjs — boot AVD + expo run:android on it",
            "type": "process",
            "command": "node",
            "args": [
                "scripts/run-android-avd.mjs",
                "mines-play-35"
            ],
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            }
        },
        {
            "label": "Android: run on 7in tablet (MinesTablet7)",
            "detail": "scripts/run-android-avd.mjs — boot AVD + expo run:android on it",
            "type": "process",
            "command": "node",
            "args": [
                "scripts/run-android-avd.mjs",
                "MinesTablet7"
            ],
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            }
        },
        {
            "label": "Android: run on 10in tablet (MinesTablet10)",
            "detail": "scripts/run-android-avd.mjs — boot AVD + expo run:android on it",
            "type": "process",
            "command": "node",
            "args": [
                "scripts/run-android-avd.mjs",
                "MinesTablet10"
            ],
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            }
        },
        {
            "label": "Android: stop all emulators",
            "detail": "scripts/run-android-avd.mjs --stop",
            "type": "process",
            "command": "node",
            "args": [
                "scripts/run-android-avd.mjs",
                "--stop"
            ],
            "problemMatcher": []
        }
    ]
}
